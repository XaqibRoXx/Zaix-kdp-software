{
  "name": "zaxis-kdp",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud-first Windows design and KDP production software",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @zaxis-kdp/desktop run dev",
    "build:desktop": "npm --workspace @zaxis-kdp/desktop run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "qa:large-book": "tsx scripts/stress-large-book.ts",
    "qa:sync-delta": "tsx scripts/stress-sync-delta.ts"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26"
  }
}
